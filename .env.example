# Configuração Firebase (Vite) — copie para .env e preencha.
# A apiKey do Firebase é pública por design; NÃO coloque client secret aqui.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Provedor OIDC corporativo (compartilhado no projeto)
VITE_OIDC_PROVIDER_ID=oidc.gestaodecapacidade

# Banco Firestore nomeado deste app
VITE_FIRESTORE_DATABASE_ID=mapa-de-calor
