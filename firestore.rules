rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mapa de Calor — Ocupação Semanal
    // ADMIN: UID fixo (bootstrap, imutável).
    // EDITOR: usuarios/{uid}.perfil == 'editor'.
    // Demais autenticados: visualização.

    function signedIn() {
      return request.auth != null;
    }

    function bootstrapAdminUid() {
      return '7eWBP7WfzJYgEcsZ0UZFD5e9RfZ2'; // jose.slima@g.globo
    }

    function isAdmin() {
      return signedIn() && request.auth.uid == bootstrapAdminUid();
    }

    function existeMeuUsuario() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function isEditor() {
      return isAdmin() || (signedIn() && existeMeuUsuario() && meuPerfil() == 'editor');
    }

    // Registros: leitura para autenticados; escrita para editor/admin (com autoria válida).
    match /ocupacoes/{docId} {
      allow read: if signedIn();
      allow create, update: if isEditor()
        && request.resource.data.atualizadoPorUid == request.auth.uid
        && request.resource.data.atualizadoPor == request.auth.token.email;
      allow delete: if false;
    }

    // Usuários/perfis.
    match /usuarios/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());

      // Auto-registro: só o próprio doc, somente como 'visualizacao', campos limitados.
      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.perfil == 'visualizacao'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'nome', 'perfil', 'atualizadoEm']);

      // Admin altera somente o perfil (e metadados de auditoria); preserva email/nome/uid.
      allow update: if isAdmin()
        && request.resource.data.perfil in ['editor', 'visualizacao']
        && request.resource.data.atualizadoPorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['perfil', 'atualizadoPor', 'atualizadoPorUid', 'atualizadoEm']);

      allow delete: if false;
    }

    // Auditoria: cliente apenas lê; escrita exclusiva do backend.
    match /historicoAlteracoes/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /historicoAcessos/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
